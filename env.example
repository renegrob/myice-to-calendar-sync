# Copy this file to .env and fill in your own values.
# .env is gitignored - never commit your actual values.

# Email address to notify when a sync run fails (via SNS + CloudWatch alarm).
# Leave empty/unset to skip alerting setup entirely.
ALERT_EMAIL=

# Optional. An S3 bucket you control for persisting per-feed sync state. Only
# needed if a feed sets respect_manual_deletions in sync_configs.py; leave
# empty otherwise. State is stored under the s3://<bucket>/aws-ical-sync/ prefix.
STATE_BUCKET=
